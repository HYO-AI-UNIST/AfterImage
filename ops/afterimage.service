[Unit]
Description=Afterimage local game server on port 7777
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/workspace/GAME_dev/Afterimage
Environment=NODE_ENV=production
Environment=CI=true
Environment=PATH=%h/workspace/GAME_dev/Afterimage/.sites-runtime/node/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/workspace/GAME_dev/Afterimage/.sites-runtime/node/bin/node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 0.0.0.0 --port 7777 --inspector-port 0 --show-interactive-dev-session=false
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillMode=control-group
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
